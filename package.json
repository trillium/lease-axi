{
  "name": "lease-axi",
  "version": "0.1.0",
  "packageManager": "pnpm@12.3.4",
  "description": "Agent ergonomic pool lease CLI: grant, renew and release concurrency slots with heartbeat expiry",
  "type": "module",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/trillium/lease-axi.git"
  },
  "keywords": [
    "lease",
    "pool",
    "concurrency",
    "cli",
    "agent",
    "axi",
    "toon"
  ],
  "bin": {
    "lease-axi": "./dist/bin/lease-axi.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "pnpm run build && vitest run",
    "test:watch": "vitest",
    "dev": "tsx bin/lease-axi.ts",
    "lint": "eslint bin src test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@toon-format/toon": "^2.1.0",
    "axi-sdk-js": "^0.1.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.0.0",
    "eslint": "10.1.0",
    "globals": "17.7.0",
    "prettier": "3.8.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.58.0",
    "vitest": "3.0.0"
  }
}
